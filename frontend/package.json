{
  "name": "mediaclipmakarr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:node-version": "node -e \"const [major, minor] = process.versions.node.split('.').map(Number); if (major < 22 || (major === 22 && minor < 20)) { console.error('Node.js >=22.20.0 is required for test:timestamps.'); process.exit(1); }\"",
    "test:timestamps": "npm run test:node-version && node --experimental-strip-types tests/timestamps.test.ts",
    "test:track-selection": "npm run test:node-version && node --experimental-strip-types --test tests/trackSelection.test.ts",
    "test:session-frames": "npm run test:node-version && node --experimental-strip-types tests/sessionFrames.test.ts",
    "test:edit-timeline": "npm run test:node-version && node --experimental-strip-types tests/editTimeline.test.ts",
    "test:trim-selection": "npm run test:node-version && node --experimental-strip-types tests/trimSelection.test.ts",
    "test": "npm run test:timestamps && npm run test:track-selection && npm run test:session-frames && npm run test:edit-timeline && npm run test:trim-selection",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.1",
    "@mui/material": "7.3.1",
    "@tanstack/react-query": "5.85.5",
    "@tanstack/react-router": "1.131.35",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}

# Copy this file to .env before running Docker Compose.
# Compose-only host settings:
MCM_COMPOSE_PORT=3623
MCM_COMPOSE_SOURCE_DIR=./data/sources

# Paths below are inside the container. Application-owned directories use named volumes and
# Plex source media is mounted read-only at /media.
MCM_PRIVATE_DATA_DIR=/data/private
MCM_WORK_DIR=/data/work
MCM_CLIP_DIR=/data/clips
MCM_SOURCE_DIRS=["/media"]

# The production image includes the pinned Jellyfin FFmpeg build at these paths.
MCM_FFMPEG_PATH=/opt/jellyfin-ffmpeg/ffmpeg
MCM_FFPROBE_PATH=/opt/jellyfin-ffmpeg/ffprobe
MCM_EXPECTED_FFMPEG_IDENTITY=7.1.4-Jellyfin
MCM_BLOCKING_IO_WORKERS=4

# Optional non-empty values override saved settings and become read-only in the UI/API.
# Leave these commented to manage them from the Settings screen.
# MCM_PLEX_URL=http://192.168.1.20:32400
# MCM_PLEX_TOKEN=replace-with-a-plex-token
# Ordered JSON mappings from Plex-reported prefixes to this host/container's source mounts.
# Windows Plex path example (when the app reads the mounted source at /media):
# MCM_SOURCE_PATH_MAPPINGS=[{"plex_prefix":"D:\\Media","local_prefix":"/media"}]
# POSIX Plex path example:
# MCM_SOURCE_PATH_MAPPINGS=[{"plex_prefix":"/srv/plex/media","local_prefix":"/media"}]
# MCM_TIMEZONE=America/Chicago
# MCM_X264_PRESET=medium

# These paths are inside the production image.
MCM_ALEMBIC_INI_PATH=/app/alembic.ini
MCM_ALEMBIC_SCRIPT_DIR=/app/alembic

# Optional development-only port overrides (useful when defaults are occupied).
MCM_DEV_API_PORT=8000
MCM_DEV_WEB_PORT=5173

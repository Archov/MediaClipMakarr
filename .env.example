# Paths are relative to the process working directory unless absolute.
MCM_PRIVATE_DATA_DIR=data/private
MCM_WORK_DIR=data/work
MCM_CLIP_DIR=data/clips

# Use JSON so Windows drive letters remain unambiguous, for example:
# MCM_SOURCE_DIRS=["D:\\Media","E:\\More Media"]
MCM_SOURCE_DIRS=["data/sources"]

# Local development must use the same pinned Jellyfin FFmpeg identity as production.
MCM_FFMPEG_PATH=ffmpeg
MCM_FFPROBE_PATH=ffprobe
MCM_EXPECTED_FFMPEG_IDENTITY=7.1.4-Jellyfin
MCM_BLOCKING_IO_WORKERS=4

# These normally resolve from the repository/container working directory.
MCM_ALEMBIC_INI_PATH=alembic.ini
MCM_ALEMBIC_SCRIPT_DIR=alembic

# Optional development-only port overrides (useful when defaults are occupied).
MCM_DEV_API_PORT=8000
MCM_DEV_WEB_PORT=5173
